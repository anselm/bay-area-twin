{
  "name": "bay-layers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A luminous, layered portrait of San Francisco Bay and the idea of a digital twin.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "check": "node --check dist/main.js && node --check scripts/serve.mjs",
    "prepare:geometry": "node scripts/prepare-geometry.mjs",
    "data:fetch": "python3 scripts/fetch-data.py && python3 scripts/fetch-features.py",
    "data:prepare": "python3 scripts/prepare-data.py && node scripts/prepare-geometry.mjs",
    "prepare:release": "node scripts/fingerprint-assets.mjs"
  }
}
